        <mxCell id="uc-01" value="UC-01: Đặt phòng &amp; Khởi tạo phiên Đấu giá (Hard Rules · TTL 60p)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1A1A1A;fontSize=12;" vertex="1" parent="sys-boundary">
