        <mxCell id="l-ui" value="Nhóm 1: Dữ Liệu Giao Diện &amp; Đơn Hàng Gốc
(UI Input, Auction &amp; Paid Orders — 8 Bảng)" style="swimlane;whiteSpace=wrap;html=1;startSize=46;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1A1A1A;fontStyle=1;fontSize=12;" vertex="1" parent="1">
