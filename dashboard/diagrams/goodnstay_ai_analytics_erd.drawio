        <mxCell id="p1-ban" value="KIẾN TRÚC 3 NHÓM DỮ LIỆU TỪ ORDER GOODNSTAY.COM CẤP NGUỒN CHO AI PHÂN TÍCH 16 BÀI TOÁN KINH DOANH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1A1A1A;fontSize=11;fontStyle=1;" vertex="1" parent="1">
