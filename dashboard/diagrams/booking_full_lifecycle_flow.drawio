        <mxCell id="fl-title" value="FLOW DIAGRAM TOÀN TRÌNH — TỪ BẤM ĐẶT PHÒNG ĐẾN TẠM KHÓA 10 PHÚT, THANH TOÁN KÝ QUỸ &amp; ĐỐI SOÁT / TỪ CHỐI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1A1A1A;fontStyle=1;fontSize=14;" vertex="1" parent="1">
