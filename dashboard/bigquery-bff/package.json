{
  "name": "goodnstay-bigquery-bff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant RBAC Backend-for-Frontend connecting Optibide Partner Hub to Google Cloud BigQuery with 6-layer cost guardrails",
  "scripts": {
    "dev": "npm run build && node dist/src/index.js",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test dist/tests/unit-cost-guard-and-rbac.test.js",
    "test:integration": "npm run build && node --test dist/tests/live-bigquery-bff.test.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
