# ==============================================================================
# goodNstay Analytics Notebooks — Local Environment Template
# Copy sang `.env` (gitignored) trước khi chạy JupyterLab:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud BigQuery (đồng bộ với dashboard/bigquery-bff/src/config.ts)
GCP_PROJECT_ID=aevo-512307
BQ_LOCATION=US
# Trần cứng chi phí quét mỗi truy vấn: 25 MiB (~$0.00015 worst-case)
BQ_MAX_BYTES_BILLED=26214400
# Chế độ đọc dữ liệu: auto (BigQuery trước -> fallback seed JSON), bigquery, seed
DATA_SOURCE_MODE=auto
# Khóa an toàn ghi ngược bảng Gold AI Mart (chỉ đổi thành true khi chủ động publish)
ALLOW_BQ_WRITEBACK=false

# 2. OpenAI API Key (BIẾN TẠM — giữ nguyên placeholder để chạy chế độ fallback 0đ)
# Khi có key thật, thay bằng sk-... ở file .env (KHÔNG commit file .env lên Git!)
OPENAI_API_KEY=sk-temp-placeholder-replace-me
OPENAI_MODEL=gpt-4o-mini
# Chế độ AI Provider (chuẩn bị cho lộ trình giảm dần OpenAI của CTO):
#   auto     = dùng OpenAI API nếu có key thật, tự chuyển fallback nếu đang là biến tạm
#   fallback = ép chạy 100% nội bộ (0 token OpenAI) để benchmark / cắt API
#   openai   = bắt buộc có OPENAI_API_KEY thật
AI_PROVIDER_MODE=auto
