# Cấu hình kết nối Jira Cloud cho goodNstay QA Bug Reporter
# Hướng dẫn lấy API Token (mất ~30 giây, không cần quyền Admin):
# 1. Truy cập: https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Bấm "Create API token" -> Đặt tên (VD: goodNstay-QA-Agent) -> Copy mã token dán vào JIRA_API_TOKEN bên dưới.

JIRA_BASE_URL=https://optibide-org.atlassian.net
JIRA_PROJECT_NAME=Internship Program 2026
# Board "Internship Program 2026" (#135) nằm trong Project Optibide (mã OP) và lọc theo Assignee cá nhân:
JIRA_PROJECT_KEY=OP
JIRA_AUTO_ASSIGN_SELF=true

# Email tài khoản Jira của bạn (sửa lại nếu bạn đăng nhập Jira bằng email công ty khác):
JIRA_EMAIL=baominh.internship@gmail.com

# Dán Personal API Token của bạn vào dòng dưới đây:
JIRA_API_TOKEN=PASTE_YOUR_ATLASSIAN_API_TOKEN_HERE
