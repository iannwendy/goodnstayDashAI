<mxfile host="app.diagrams.net" agent="Antigravity-DrawioBuilder" version="24.7.17">
  <diagram id="goodnstay-booking-flow" name="Booking Payment Flow">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Swimlane 1: Guest -->
        <mxCell id="lane-guest" value="Khách hàng (Guest)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="320" height="680" as="geometry" />
        </mxCell>
        <mxCell id="n-start" value="Chọn phòng &amp; ngày lưu trú" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="lane-guest">
          <mxGeometry x="70" y="70" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-checkout" value="Gửi yêu cầu đặt phòng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-guest">
          <mxGeometry x="70" y="190" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n-success-ui" value="Nhận xác nhận đặt phòng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="lane-guest">
          <mxGeometry x="70" y="540" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Swimlane 2: goodNstay Backend -->
        <mxCell id="lane-backend" value="Hệ thống goodNstay (Backend)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="360" height="680" as="geometry" />
        </mxCell>
        <mxCell id="n-check-avail" value="Kiểm tra phòng trống &amp; giữ chỗ tạm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="90" y="190" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n-dec-avail" value="Còn phòng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="95" y="320" width="180" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n-reject" value="Trả thông báo hết phòng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="90" y="450" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n-confirm-db" value="Cập nhật Booking Confirmed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="90" y="538" width="190" height="54" as="geometry" />
        </mxCell>

        <!-- Swimlane 3: Payment Gateway -->
        <mxCell id="lane-payment" value="Cổng thanh toán (Payment Gateway)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="320" height="680" as="geometry" />
        </mxCell>
        <mxCell id="n-charge" value="Xử lý giao dịch &amp; gửi Webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane-payment">
          <mxGeometry x="65" y="334" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Intra-lane Edges -->
        <mxCell id="e-start-checkout" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" edge="1" parent="lane-guest" source="n-start" target="n-checkout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-check-dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" edge="1" parent="lane-backend" source="n-check-avail" target="n-dec-avail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dec-no" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="lane-backend" source="n-dec-avail" target="n-reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-lane Edges (parent="1") -->
        <mxCell id="e-checkout-check" value="POST /bookings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-checkout" target="n-check-avail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dec-yes" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-dec-avail" target="n-charge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-charge-confirm" value="Payment Paid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-charge" target="n-confirm-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-confirm-guest" value="Thông báo thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-confirm-db" target="n-success-ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
